{
  "name": "godville-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --outdir ./dist --target bun --external playwright",
    "check": "bun ./node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "start": "bun ./dist/cli.js",
    "dev": "bun ./src/cli.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "playwright": "^1.63.0"
  }
}
