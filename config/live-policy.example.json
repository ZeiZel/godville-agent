{
  "schemaVersion": "live-policy/v1",
  "rules": [
    {
      "id": "block-unknown-mode",
      "safety": "block",
      "priority": 1000,
      "weight": 1,
      "when": [{ "field": "mode", "compare": "equals", "value": "unknown" }],
      "sequence": []
    },
    {
      "id": "arena-finish-punish",
      "safety": "normal",
      "priority": 850,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "arena" },
        { "field": "readiness.arena.ordinary", "compare": "equals", "value": true },
        { "field": "readiness.arena.influence", "compare": "equals", "value": true },
        { "field": "health.percent", "compare": "gte", "value": 35 },
        { "field": "opponent.health.percent", "compare": "lte", "value": 20 },
        { "field": "prana.current", "compare": "gte", "value": 25 }
      ],
      "sequence": ["hero.punish"]
    },
    {
      "id": "arena-heal-influence",
      "safety": "normal",
      "priority": 900,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "arena" },
        { "field": "readiness.arena.ordinary", "compare": "equals", "value": true },
        { "field": "readiness.arena.influence", "compare": "equals", "value": true },
        { "field": "health.percent", "compare": "lte", "value": 35 },
        { "field": "prana.current", "compare": "gte", "value": 25 }
      ],
      "sequence": ["hero.encourage"]
    },
    {
      "id": "arena-heal-voice",
      "safety": "normal",
      "priority": 800,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "arena" },
        { "field": "readiness.arena.ordinary", "compare": "equals", "value": true },
        { "field": "readiness.arena.voice", "compare": "equals", "value": true },
        { "field": "health.percent", "compare": "lte", "value": 50 },
        { "field": "prana.current", "compare": "gte", "value": 5 }
      ],
      "sequence": ["arena.voice.heal"]
    },
    {
      "id": "arena-attack-voice",
      "safety": "normal",
      "priority": 700,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "arena" },
        { "field": "readiness.arena.ordinary", "compare": "equals", "value": true },
        { "field": "readiness.arena.voice", "compare": "equals", "value": true },
        { "field": "health.percent", "compare": "gte", "value": 35 },
        { "field": "prana.current", "compare": "gte", "value": 5 }
      ],
      "sequence": ["arena.voice.attack"]
    },
    {
      "id": "restore-before-zpg-hour",
      "safety": "normal",
      "priority": 998,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "readiness.arena.reserve", "compare": "equals", "value": true },
        { "field": "prana.current", "compare": "lte", "value": 49 },
        { "field": "charges.current", "compare": "gte", "value": 101 }
      ],
      "sequence": ["hero.restore_prana"]
    },
    {
      "id": "restore-for-zpg-window",
      "safety": "normal",
      "priority": 999,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "readiness.zpg", "compare": "equals", "value": true },
        { "field": "prana.current", "compare": "lte", "value": 49 },
        { "field": "charges.current", "compare": "gte", "value": 101 }
      ],
      "sequence": ["hero.restore_prana"]
    },
    {
      "id": "zpg-opening-window",
      "safety": "normal",
      "priority": 1000,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "readiness.zpg", "compare": "equals", "value": true },
        { "field": "prana.current", "compare": "gte", "value": 50 }
      ],
      "sequence": ["arena.zpg.start"]
    },
    {
      "id": "restore-for-qualified-polygon",
      "safety": "normal",
      "priority": 300,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "readiness.polygon", "compare": "equals", "value": true },
        { "field": "readiness.arena.reserve", "compare": "equals", "value": false },
        { "field": "prana.current", "compare": "lte", "value": 49 },
        { "field": "charges.current", "compare": "gte", "value": 101 }
      ],
      "sequence": ["hero.restore_prana"]
    },
    {
      "id": "start-ready-polygon",
      "safety": "normal",
      "priority": 200,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "readiness.polygon", "compare": "equals", "value": true },
        { "field": "readiness.arena.reserve", "compare": "equals", "value": false },
        { "field": "prana.current", "compare": "gte", "value": 80 }
      ],
      "sequence": ["adventure.polygon.start"]
    },
    {
      "id": "emergency-field-heal",
      "safety": "normal",
      "priority": 450,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "health.percent", "compare": "lte", "value": 35 },
        { "field": "prana.current", "compare": "gte", "value": 25 }
      ],
      "sequence": ["hero.encourage"]
    },
    {
      "id": "critical-active-dungeon-heal",
      "safety": "normal",
      "priority": 500,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "dungeon" },
        { "field": "health.percent", "compare": "lte", "value": 45 },
        { "field": "prana.current", "compare": "gte", "value": 25 }
      ],
      "sequence": ["hero.encourage"]
    },
    {
      "id": "safe-active-polygon-push",
      "safety": "normal",
      "priority": 400,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "polygon" },
        { "field": "prana.current", "compare": "gte", "value": 15 }
      ],
      "sequence": ["polygon.move.safe"]
    },
    {
      "id": "safe-active-dungeon-navigation",
      "safety": "normal",
      "priority": 400,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "dungeon" },
        { "field": "readiness.dungeon.navigation", "compare": "equals", "value": true },
        { "field": "prana.current", "compare": "gte", "value": 30 }
      ],
      "sequence": ["dungeon.move.auto"]
    },
    {
      "id": "restore-for-qualified-dungeon",
      "safety": "normal",
      "priority": 300,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "health.percent", "compare": "gte", "value": 60 },
        { "field": "prana.current", "compare": "lte", "value": 49 },
        { "field": "charges.current", "compare": "gte", "value": 101 },
        { "field": "readiness.arena.reserve", "compare": "equals", "value": false },
        { "field": "readiness.dungeon", "compare": "equals", "value": true }
      ],
      "sequence": ["hero.restore_prana"]
    },
    {
      "id": "start-qualified-dungeon",
      "safety": "normal",
      "priority": 200,
      "weight": 100,
      "when": [
        { "field": "freshness", "compare": "equals", "value": "fresh" },
        { "field": "mode", "compare": "equals", "value": "idle" },
        { "field": "health.percent", "compare": "gte", "value": 60 },
        { "field": "prana.current", "compare": "gte", "value": 75 },
        { "field": "readiness.arena.reserve", "compare": "equals", "value": false },
        { "field": "readiness.dungeon", "compare": "equals", "value": true }
      ],
      "sequence": ["adventure.dungeon.start"]
    },
    {
      "id": "zpg-observe-only-when-unknown",
      "safety": "normal",
      "priority": 10,
      "weight": 1,
      "when": [{ "field": "readiness.zpg", "compare": "missing", "value": true }],
      "sequence": []
    }
  ]
}
