# Sample public policy values. Import a real balance through the local CLI after manual verification.
GODVILLE_INITIAL_CHARGES=334
GODVILLE_RESERVE_CHARGES=100
GODVILLE_MAX_CHARGES_PER_DAY=2
GODVILLE_MAX_CHARGES_PER_7D=10
GODVILLE_MAX_CHARGES_PER_EXPEDITION=1
GODVILLE_MODE=advisor
# Set these only to use the official read-only API. Keep the token in a mounted secret file.
# GODVILLE_GOD_NAME=your_god_name
# GODVILLE_TOKEN_FILE=/run/secrets/godville_token
# Browser mode is disabled by default and requires a separately verified handler manifest.
# GODVILLE_BROWSER_ENABLED=false
