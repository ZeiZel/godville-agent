# Defaults used by the offline advisor. This file has no secrets and may be copied to .env locally.
GODVILLE_DATA_DIR=./data
GODVILLE_LOG_DIR=./data/automation/logs
GODVILLE_MODE=advisor
GODVILLE_RESERVE_CHARGES=100
GODVILLE_MAX_CHARGES_PER_DAY=2
GODVILLE_MAX_CHARGES_PER_7D=10
GODVILLE_MAX_CHARGES_PER_EXPEDITION=1
GODVILLE_ZPG_ENABLED=false
GODVILLE_ZPG_CONFIRMATION=false
GODVILLE_ZPG_MIN_OFFSET_SECONDS=5
GODVILLE_ZPG_MAX_OFFSET_SECONDS=160

# Official read-only API; use a mounted file, never a token in this file or argv.
# GODVILLE_GOD_NAME=your_god_name
# GODVILLE_TOKEN_FILE=/run/secrets/godville_token
# GODVILLE_API_INTERVAL_SECONDS=75

# Browser commands are disabled by default. The included fixture catalog is local-only.
# GODVILLE_BROWSER_ENABLED=true
# GODVILLE_BROWSER_MANIFEST=config/handlers.fixture.json
# GODVILLE_BROWSER_STATE_DIR=./browser-state
# GODVILLE_BROWSER_HEADLESS=true
# GODVILLE_BROWSER_ALLOW_REMOTE=false

# Strict declarative policy for `live plan` and `live run`; it cannot set selectors or costs.
# GODVILLE_LIVE_POLICY_FILE=config/live-policy.example.json

# Host live run uses an already-open Orca embedded-browser page; keep the page ID local.
# GODVILLE_MODE=browser
# GODVILLE_BROWSER_ENABLED=true
# GODVILLE_GOD_NAME=your_god_name
# GODVILLE_LIVE_POLICY_FILE=config/live-policy.example.json
# GODVILLE_ORCA_PAGE_ID=00000000-0000-4000-8000-000000000000
# GODVILLE_ORCA_COMMAND=orca

# Continuous host run and dashboard logs (the dashboard remains read-only).
# GODVILLE_LOG_DIR=./data/automation/logs
# bun run dev -- live run
